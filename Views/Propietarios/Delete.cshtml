@model Inmobiliaria.Models.Propietario

@{
    ViewData["Title"] = "Eliminar propietario";
}

<h1>Eliminar propietario</h1>

<div class="alert alert-warning">
    ¿Confirmás que querés eliminar este propietario? Esta acción no se puede deshacer.
</div>

<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre @Model.Apellido</dd>

    <dt class="col-sm-2">DNI</dt>
    <dd class="col-sm-10">@Model.Dni</dd>

    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>

    <dt class="col-sm-2">Teléfono</dt>
    <dd class="col-sm-10">@Model.Telefono</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="IdPropietario" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>