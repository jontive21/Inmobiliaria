@model Inmobiliaria.Models.Inquilino

@{
    ViewData["Title"] = "Editar Inquilino";
}

<h1>Editar Inquilino</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <!-- AQUÍ ESTÁ LA CLAVE: debe decir asp-action="Edit" -->
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <!-- Este campo oculto es OBLIGATORIO para que el POST sepa qué ID modificar -->
            <input type="hidden" asp-for="IdInquilino" />
            
            <div class="form-group mb-3">
                <label asp-for="Dni" class="control-label"></label>
                <input asp-for="Dni" class="form-control" readonly />
                <span asp-validation-for="Dni" class="text-danger"></span>
                <small class="text-muted">El DNI no se puede modificar.</small>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="NombreCompleto" class="control-label"></label>
                <input asp-for="NombreCompleto" class="form-control" />
                <span asp-validation-for="NombreCompleto" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Telefono" class="control-label"></label>
                <input asp-for="Telefono" class="form-control" />
                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Guardar Cambios" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
            </div>
        </form>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mt-3">@ViewBag.Error</div>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}